FROM python:3.12-slim

ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

WORKDIR /app

COPY pyproject.toml README.md AGENTS.md GIT-FLOW.md test.sh Dockerfile.test ./
COPY .github ./.github
COPY acceptance ./acceptance
COPY coordination ./coordination
COPY coordinates ./coordinates
COPY catalogue ./catalogue
COPY products ./products
COPY docs ./docs
COPY scripts ./scripts
COPY src ./src
COPY tests ./tests

RUN python -m pip install .
RUN python -m pip install --force-reinstall --no-deps \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/4fb75b7b6c1a16ec3b8c1d78dec6ad1a4ad1b40a.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/4fb75b7b6c1a16ec3b8c1d78dec6ad1a4ad1b40a.zip#subdirectory=control-plane-kit-operations"

CMD ["python", "scripts/run_all_tests.py"]
