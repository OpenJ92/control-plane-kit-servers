FROM python:3.12-slim

ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      coreutils \
      curl \
      docker-cli \
      git \
      libdigest-sha-perl \
      mawk \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md AGENTS.md GIT-FLOW.md test.sh Dockerfile.test ./
COPY .github ./.github
COPY acceptance ./acceptance
COPY coordination ./coordination
COPY coordinates ./coordinates
COPY catalogue ./catalogue
COPY products ./products
COPY docs ./docs
COPY scripts ./scripts
COPY src ./src
COPY tests ./tests

RUN python -m pip install .
RUN python -m pip install --force-reinstall --no-deps \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/be60608ae11745d0ac1cfa7f696ca22be1f706ce.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/be60608ae11745d0ac1cfa7f696ca22be1f706ce.zip#subdirectory=control-plane-kit-operations" \
    "rfc8785==0.1.4"

CMD ["python", "scripts/run_all_tests.py"]
