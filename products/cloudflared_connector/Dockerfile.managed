FROM cloudflare/cloudflared:2026.6.1@sha256:6d91c121b803126f7a5344005d17a9324788fc09d305b6e2560ec6040a7ae283 AS native

FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS notices
COPY products/cloudflared_connector/licenses /build-notices
RUN python /build-notices/collect.py

FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/products/cloudflared_connector/src \
    CPK_WRAPPER_CONFIGURATION_FILE=/etc/cpk/cloudflared/control.json
WORKDIR /app

RUN python -m pip install --no-cache-dir \
    "control-plane-kit-server-sdk[verification] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/1657cb91b143931bafcdb32108950d2bbbb66d95.zip"

COPY --from=native /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY --from=notices /licenses/cloudflared /usr/share/licenses/cloudflared
COPY products/cloudflared_connector/src ./products/cloudflared_connector/src

USER 65532:65532
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=5s --timeout=3s --retries=1 \
    CMD ["python", "-m", "control_plane_kit_servers_cloudflared_connector.readiness"]
ENTRYPOINT ["python", "-m", "control_plane_kit_servers_cloudflared_connector.entrypoint"]
CMD []
