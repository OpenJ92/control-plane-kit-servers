# External acquisition driver, not a graph product or a replacement server image.
ARG CPK_IMAGE
FROM ${CPK_IMAGE}
# Existing SDK archive helpers need root on a new volume. Public setup explicitly
# drops to the inspected CPK image UID and receives no Docker socket.
USER 0
RUN python -m pip install --no-cache-dir --force-reinstall \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/879efb9576ac0580a6236d0a7372c036537b4dfe.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/879efb9576ac0580a6236d0a7372c036537b4dfe.zip#subdirectory=control-plane-kit-operations" \
    "control-plane-kit-server-sdk[fastapi] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/43838fd0f4391428cfffa87f8c4dbd5cc6d5eab1.zip" \
    "control-plane-kit-interpreters[cloudflare,docker,gateway,public-dns] @ https://github.com/OpenJ92/control-plane-kit-interpreters/archive/6faf6698e47381476fb2f09058894eab16f0c768.zip" \
    "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/78a2ed7c8abee6da31f8661993ed4c5426edd7ee.zip"
COPY products/cpk_server/src /app/products/cpk_server/src
COPY products/secrets_server/src /app/products/secrets_server/src
COPY products/postgres_server/src /app/products/postgres_server/src
ENV PYTHONPATH=/app/products/cpk_server/src:/app/products/cpk_local_gateway/src:/app/products/secrets_server/src:/app/products/postgres_server/src
# Commissioning overrides USER explicitly to the approved operator UID/GID.
CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
