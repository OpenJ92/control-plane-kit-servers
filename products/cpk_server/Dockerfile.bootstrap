# External acquisition driver, not a graph product or a replacement server image.
ARG CPK_IMAGE
FROM ${CPK_IMAGE}
# Existing SDK archive helpers need root on a new volume. Public setup explicitly
# drops to the inspected CPK image UID and receives no Docker socket.
USER 0
RUN python -m pip install --no-cache-dir \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/955666898218e4f2956b6e9fcd33bdba97ffdb06.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/955666898218e4f2956b6e9fcd33bdba97ffdb06.zip#subdirectory=control-plane-kit-operations" \
    "control-plane-kit-server-sdk[fastapi] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/cad5cc3dacbff1da79e6cc8b4c0c88526363e033.zip" \
    "control-plane-kit-interpreters[cloudflare,docker,gateway,public-dns] @ https://github.com/OpenJ92/control-plane-kit-interpreters/archive/528fb20692400c01e107f86b3952a52a70883652.zip" \
    "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/f4747b23872aca537786f86017feb25e0ae83fbd.zip"
COPY products/cpk_server/src /app/products/cpk_server/src
COPY products/secrets_server/src /app/products/secrets_server/src
ENV PYTHONPATH=/app/products/cpk_server/src:/app/products/cpk_local_gateway/src:/app/products/secrets_server/src
# Commissioning overrides USER explicitly to the approved operator UID/GID.
CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
