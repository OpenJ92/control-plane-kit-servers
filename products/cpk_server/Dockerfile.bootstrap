# External acquisition driver, not a graph product or a replacement server image.
ARG CPK_IMAGE
FROM ${CPK_IMAGE}
# Existing SDK archive helpers need root on a new volume. Public setup explicitly
# drops to the inspected CPK image UID and receives no Docker socket.
USER 0
RUN python -m pip install --no-cache-dir --force-reinstall \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/976901c609d950a557ec1e9966f018e8ff6e16aa.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/976901c609d950a557ec1e9966f018e8ff6e16aa.zip#subdirectory=control-plane-kit-operations" \
    "control-plane-kit-server-sdk[fastapi] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/d61b374cb2a23d773c31748f47f88169499298b7.zip" \
    "control-plane-kit-interpreters[cloudflare,docker,gateway,public-dns] @ https://github.com/OpenJ92/control-plane-kit-interpreters/archive/e4bd35e828d1c44129f64e702de2b1d2b60f7c87.zip" \
    "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/158b17ed10689360c4e1529a395b3ee2b47aecbc.zip"
COPY products/cpk_server/src /app/products/cpk_server/src
COPY products/secrets_server/src /app/products/secrets_server/src
COPY products/postgres_server/src /app/products/postgres_server/src
ENV PYTHONPATH=/app/products/cpk_server/src:/app/products/cpk_local_gateway/src:/app/products/secrets_server/src:/app/products/postgres_server/src
# Commissioning overrides USER explicitly to the approved operator UID/GID.
CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
