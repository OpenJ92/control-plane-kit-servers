# External acquisition driver, not a graph product or a replacement server image.
ARG CPK_IMAGE
FROM ${CPK_IMAGE}
# Existing SDK archive helpers need root on a new volume. Public setup explicitly
# drops to the inspected CPK image UID and receives no Docker socket.
USER 0
RUN python -m pip install --no-cache-dir --force-reinstall \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/7afef43f3d3b981094e37dcb3062b6e3a4f3d674.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/7afef43f3d3b981094e37dcb3062b6e3a4f3d674.zip#subdirectory=control-plane-kit-operations" \
    "control-plane-kit-server-sdk[fastapi] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/220f63169e4bac79653937e97727406255279f7b.zip" \
    "control-plane-kit-interpreters[cloudflare,docker,gateway,public-dns] @ https://github.com/OpenJ92/control-plane-kit-interpreters/archive/71ab335d45ee804f2aec33c519639c75313626f0.zip" \
    "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/a3ca9634574484a0018bf73b375d94fab70f169a.zip"
COPY products/cpk_server/src /app/products/cpk_server/src
COPY products/secrets_server/src /app/products/secrets_server/src
COPY products/postgres_server/src /app/products/postgres_server/src
ENV PYTHONPATH=/app/products/cpk_server/src:/app/products/cpk_local_gateway/src:/app/products/secrets_server/src:/app/products/postgres_server/src
# Commissioning overrides USER explicitly to the approved operator UID/GID.
CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
