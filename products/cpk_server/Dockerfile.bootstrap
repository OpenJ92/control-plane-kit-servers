# External acquisition driver, not a graph product or a replacement server image.
ARG CPK_IMAGE
FROM ${CPK_IMAGE}
# Existing SDK archive helpers need root on a new volume. Public setup explicitly
# drops to the inspected CPK image UID and receives no Docker socket.
USER 0
RUN python -m pip install --no-cache-dir --force-reinstall \
    "control-plane-kit-core @ https://github.com/OpenJ92/control-plane-kit/archive/fec0816281aeb83ede98616adcc4f96dfe5777a8.zip#subdirectory=control-plane-kit-core" \
    "control-plane-kit-operations @ https://github.com/OpenJ92/control-plane-kit/archive/fec0816281aeb83ede98616adcc4f96dfe5777a8.zip#subdirectory=control-plane-kit-operations" \
    "control-plane-kit-server-sdk[fastapi] @ https://github.com/OpenJ92/control-plane-kit-server-sdk/archive/cd4722fbfb942e7c2467a39b3cd0e32ded4a90ac.zip" \
    "control-plane-kit-interpreters[cloudflare,docker,gateway,public-dns] @ https://github.com/OpenJ92/control-plane-kit-interpreters/archive/27457ca5eab6ae96d78146e7ea0c998b986feab3.zip" \
    "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/46e0718664c425d002f2420a6ad1f996be62b2c5.zip"
COPY products/cpk_server/src /app/products/cpk_server/src
COPY products/secrets_server/src /app/products/secrets_server/src
COPY products/postgres_server/src /app/products/postgres_server/src
ENV PYTHONPATH=/app/products/cpk_server/src:/app/products/cpk_local_gateway/src:/app/products/secrets_server/src:/app/products/postgres_server/src
# Commissioning overrides USER explicitly to the approved operator UID/GID.
CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
