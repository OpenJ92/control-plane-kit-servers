FROM cpk-bootstrap-driver-base

USER 0
ENV PYTHONPATH="" PYTHONDONTWRITEBYTECODE=1
WORKDIR /installer
COPY cohort /opt/cpk-bootstrap-driver-build
COPY products/cpk_server/bootstrap-driver-cohort.json /usr/share/cpk-bootstrap-driver/cohort.json
COPY products/cpk_server/tests/grandparent_image_check.py /usr/share/cpk-bootstrap-driver/grandparent_image_check.py
COPY products/cpk_server/tests/bootstrap_driver_imports.py /usr/share/cpk-bootstrap-driver/bootstrap_driver_imports.py
COPY products/cpk_server/tests/bootstrap_driver_image_check.py /usr/share/cpk-bootstrap-driver/check.py
# Only the qualification helper imports these maintained synthetic fixtures.
# The installed production CLI has no source-overlay dependency.
COPY cohort/servers/products /usr/share/cpk-bootstrap-driver/fixtures/products
COPY cohort/servers/scripts/root_material_preparation_tests.py /usr/share/cpk-bootstrap-driver/fixtures/scripts/root_material_preparation_tests.py
RUN python /usr/share/cpk-bootstrap-driver/check.py seal \
    && python -m pip install --no-cache-dir --index-url https://pypi.org/simple \
       "setuptools==80.9.0" "wheel==0.45.1" \
    && python -m pip install --no-cache-dir --no-index --no-deps --no-build-isolation --force-reinstall \
       /opt/cpk-bootstrap-driver-build/core /opt/cpk-bootstrap-driver-build/operations \
       /opt/cpk-bootstrap-driver-build/interpreters /opt/cpk-bootstrap-driver-build/secrets \
       /opt/cpk-bootstrap-driver-build/servers \
    && python /usr/share/cpk-bootstrap-driver/check.py verify \
    && rm -rf /opt/cpk-bootstrap-driver-build

CMD ["python", "-m", "control_plane_kit_servers_cpk_server.bootstrap_cli"]
