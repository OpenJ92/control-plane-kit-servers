FROM cpk-secrets-parent-base

# The verified accepted child product remains the base; only the provider
# distribution changes. Existing Core/SDK, wrapper and normal entry stay intact.
USER 0
RUN python -m pip install --no-cache-dir --index-url https://pypi.org/simple \
      "setuptools==80.9.0" "wheel==0.45.1" \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation --force-reinstall \
      "control-plane-kit-secrets @ https://github.com/OpenJ92/control-plane-kit-secrets/archive/57e4fc61d6931ef078550f98154a585bda61987b.zip" \
    && python -m pip check
USER 10006
